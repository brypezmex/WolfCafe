# Copy to .env and fill in real values before running `docker compose up -d`.
# .env is gitignored -- never commit real secrets.

# ---- database --------------------------------------------------------------
DB_NAME=wolfcafe
# Required. Used as the MySQL root password and by the backend to connect.
DB_PASSWORD=change-me-to-a-long-random-string

# ---- application secrets ---------------------------------------------------
# Required. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
JWT_EXPIRATION_MS=604800000

# Required. Shared by the three seeded accounts: admin, staff, and customer.
# These accounts are created automatically and are well known, so change this
# before exposing the site publicly.
DEFAULT_PASSWORD=change-me

# ---- networking ------------------------------------------------------------
# Host port the site is served on. Point your Cloudflare Tunnel here.
WEB_PORT=8080

# API path the frontend calls. Keep the relative default so the site works on
# any hostname or IP; only change it if the API is on a separate origin.
VITE_API_BASE_URL=/api

# Browser origins allowed to call the API directly. Irrelevant while requests
# go through the nginx proxy (they are same-origin), so "*" is a safe default.
CORS_ALLOWED_ORIGINS=*

# ---- nightly database reset ------------------------------------------------
DB_RESET_ENABLED=true
# Spring 6-field cron: second minute hour day-of-month month day-of-week.
# Default is midnight every day.
DB_RESET_CRON=0 0 0 * * *
DB_RESET_ZONE=America/New_York

# ---- content moderation ----------------------------------------------------
PROFANITY_FILTER_ENABLED=true

# ---- optional: cloudflared sidecar (docker compose --profile tunnel up -d) --
# Token from the Cloudflare Zero Trust dashboard. Route the tunnel's public
# hostname to http://frontend:80.
# TUNNEL_TOKEN=
