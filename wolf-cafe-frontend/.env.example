# Frontend build/dev configuration. Copy to .env to use locally.
#
# Where the app sends API requests. Leave unset (or '/api') for the Docker
# deployment, where nginx proxies /api to the backend on the same origin --
# that is what lets the site work on any IP or Cloudflare Tunnel hostname.
# VITE_API_BASE_URL=/api

# Only used by `npm run dev`: where the Vite dev server forwards /api.
# DEV_API_PROXY_TARGET=http://localhost:8080

# Port for `npm run dev` / `npm run preview`.
# PORT=3000
